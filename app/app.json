{
  "expo": {
    "name": "Ludok Home",
    "slug": "ludok-home",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ludokhome",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ludok.home",
      "adaptiveIcon": {
        "backgroundColor": "#7A45C4",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "allowBackup": false,
      "versionCode": 13
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#0a0a0c"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#7A45C4",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-share-intent",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para el tiempo de donde estás. Solo la ubicación aproximada.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para poner una foto a lo que guardas en la wishlist o en regalos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
