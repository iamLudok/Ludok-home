# ── Nextcloud ──────────────────────────────────────────────
# Your Nextcloud instance URL (no trailing slash)
# Example: http://192.168.1.50:8080
NEXTCLOUD_URL=http://YOUR_IP:PORT
NEXTCLOUD_USER=your_nextcloud_username
NEXTCLOUD_PASSWORD=your_nextcloud_password

# Optional: folder in your Nextcloud files where the news audio is left for
# the Ludok Home app. Defaults to "Ludok Home".
# NEXTCLOUD_FOLDER=Ludok Home

# ── Noticias en audio (optional) ───────────────────────────
# Path to a Piper voice model. Defaults to voices/es_ES-davefx-medium.onnx,
# which deploy/setup.sh downloads for you.
# PIPER_VOICE=/path/to/voice.onnx
